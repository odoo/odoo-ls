<odoo>
    <!-- ir.model record for pygls.tests.xml_test_model (enables model class XML hover) -->
    <record id="xml_test_model" model="ir.model">
        <field name="model">x_test_model</field>
        <field name="name">Base Test Model</field>
    </record>
    <!-- ir.model.fields record for x_name field (enables field XML hover) -->
    <record id="field_xml_test_model_name" model="ir.model.fields">
        <!--  -->
        <field name="model_id" ref="xml_test_model"/> 
        <field name="name">x_name</field>
        <field name="ttype">char</field>
    </record>

    <!-- data record of xml_test_model (enables record XML hover) -->
    <record id="test_xml_test_record" model="x_test_model">
        <field name="x_name">Test Record</field>
    </record>
</odoo>
