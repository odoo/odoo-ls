<odoo>
    <!-- Tree (List) View -->
    <record id="view_test_model_tree" model="ir.ui.view">
        <field name="name">x_test_model.tree</field>
        <field name="model">x_test_model</field>
        <field name="arch" type="xml">
            <list string="Test Model List">
                <field name="x_name"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_test_model_form" model="ir.ui.view">
        <field name="name">x_test_model.form</field>
        <field name="model">x_test_model</field>
        <field name="arch" type="xml">
            <form string="Test Model Form">
                <sheet>
                    <group>
                        <field name="x_name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_test_model" model="ir.actions.act_window">
        <field name="name">Test Models</field>
        <field name="res_model">x_test_model</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_test_model_root" name="Test Models" sequence="10"/>
    <menuitem id="menu_test_model_list" name="Instances" parent="menu_test_model_root" action="action_test_model" sequence="10"/>

</odoo>
